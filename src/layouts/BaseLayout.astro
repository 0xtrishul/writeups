---
import '../styles/terminal.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'writeups — offensive security, ctf, reverse engineering.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="trishul (mah4dev)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0d0d0d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="wrap">
      <slot />
      <footer class="foot">
        <span>har har mahadev.</span>
        <span><a href="https://trishul.re">trishul.re</a> · built with astro</span>
      </footer>
    </main>
  </body>
</html>
